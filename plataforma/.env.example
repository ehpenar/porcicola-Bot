VITE_DEMO_MODE=true
# Secreto compartido n8n ↔ plataforma (header X-Enlace-Secret). En demo por defecto: porcicola-enlace-demo
# En Netlify: solo ENLACE_API_KEY (secret). No uses VITE_ENLACE_API_KEY como secret — falla el build.
ENLACE_API_KEY=porcicola-enlace-demo
# Optional later: Supabase keys when leaving demo mode
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
